diff -urN --strip-trailing-cr app/Services/Learning/Pull.php /www/ctc/app/Services/Learning/Pull.php
--- a/app/Services/Learning/Pull.php	1970-01-01 08:00:00.000000000 +0800
+++ b/app/Services/Learning/Pull.php	2026-11-05 22:58:53.605119928 +0800
@@ -0,0 +1,151 @@
+<?php
+/**
+ * 对端增量拉取（考试平台补漏推）
+ *
+ * 推送是「本平台推、对端收」，一旦网关抖动或对端短暂不可用，
+ * 光靠重试可能仍会漏；拉取给对端一个主动对齐的入口：
+ * 对端按游标（afterId）从本平台取增量事件，自己按 eventId 幂等入库。
+ *
+ * 为什么用自增 id 而不是时间戳做游标：
+ * 同一秒内可能有多条事件入箱，时间戳做游标会漏读（>= 会重复、> 会漏）。
+ * 自增 id 单调递增，天然适合做游标。
+ *
+ * 只输出正式通道（official）事件：扩展事件不在事件目录内，
+ * 混进正式通道会让下游按「未知事件类型」告警（接入说明 8.1）。
+ */
+
+namespace App\Services\Learning;
+
+use App\Models\ExamOutbox as ExamOutboxModel;
+use App\Repos\ExamOutbox as ExamOutboxRepo;
+use App\Services\Service;
+
+class Pull extends Service
+{
+
+    /**
+     * 拉取增量事件
+     *
+     * @param string $source 对端标识
+     * @param string $userKey 对外 userId（OIDC sub 或 usr_ 占位）
+     * @param int $afterId 游标，取 id 大于该值的事件
+     * @param int $since 起始时间戳，0 表示不限
+     * @param int $limit 期望条数，0 表示取对端配置上限
+     * @return array
+     */
+    public function events($source, $userKey, $afterId = 0, $since = 0, $limit = 0)
+    {
+        $registry = new Peers();
+
+        if (!$registry->hasAbility($source, 'pull')) {
+            return $this->reject('PULL_NOT_OPEN', sprintf('对端 %s 未开通拉取通道', $source));
+        }
+
+        $peer = $registry->get($source);
+
+        $max = (int)$peer['pull_limit'];
+
+        $limit = (int)$limit;
+
+        if ($limit <= 0) $limit = $max;
+
+        if ($limit > $max) $limit = $max;
+
+        $identity = new IdentityKey();
+
+        $userId = (int)$identity->resolveUserId((string)$userKey);
+
+        if ($userId <= 0) {
+            return $this->reject('USER_NOT_FOUND', '该用户不存在');
+        }
+
+        $repo = new ExamOutboxRepo();
+
+        $rows = $repo->findPullable($userId, $source, (int)$afterId, (int)$since, $limit + 1, $peer['events']);
+
+        $items = [];
+
+        $cursor = (int)$afterId;
+
+        $hasMore = false;
+
+        foreach ($rows as $row) {
+
+            if (count($items) >= $limit) {
+                $hasMore = true;
+                break;
+            }
+
+            $items[] = $this->format($row);
+
+            $cursor = (int)$row->id;
+        }
+
+        return [
+            'ok' => true,
+            'code' => 'OK',
+            'message' => 'success',
+            'data' => [
+                'peer' => $source,
+                'userId' => (string)$userKey,
+                'channel' => Peers::CHANNEL_OFFICIAL,
+                'afterId' => (int)$afterId,
+                'nextCursor' => $cursor,
+                'hasMore' => $hasMore,
+                'limit' => $limit,
+                'count' => count($items),
+                'events' => $items,
+            ],
+        ];
+    }
+
+    /**
+     * 单条事件转对外结构
+     *
+     * course_key 形如 course_12，直接转 int 会得到 0，
+     * 这里取末尾数字，兼容纯数字与带前缀两种写法。
+     *
+     * @param ExamOutboxModel $row
+     * @return array
+     */
+    protected function format(ExamOutboxModel $row)
+    {
+        $courseId = 0;
+
+        if (preg_match('/(\d+)$/', (string)$row->course_key, $match)) {
+            $courseId = (int)$match[1];
+        }
+
+        return [
+            'eventId' => (string)$row->event_id,
+            'eventType' => (string)$row->event_type,
+            'eventVersion' => (string)$row->event_version,
+            'occurredAt' => gmdate('Y-m-d\TH:i:s\Z', (int)$row->occurred_at),
+            'userId' => (string)$row->user_key,
+            'courseId' => $courseId,
+            'progress' => (int)$row->progress,
+            'deliveryStatus' => (int)$row->status,
+            'deliveryText' => $row->getStatusText(),
+            'acked' => $row->isAcked(),
+            'remoteId' => (string)$row->remote_id,
+            'sentAt' => $row->sent_at > 0 ? gmdate('Y-m-d\TH:i:s\Z', (int)$row->sent_at) : null,
+            'payload' => $row->getPayloadArray(),
+        ];
+    }
+
+    /**
+     * @param string $code
+     * @param string $message
+     * @return array
+     */
+    protected function reject($code, $message)
+    {
+        return [
+            'ok' => false,
+            'code' => $code,
+            'message' => $message,
+            'data' => [],
+        ];
+    }
+
+}
diff -urN --strip-trailing-cr app/Services/Learning/Receipt.php /www/ctc/app/Services/Learning/Receipt.php
--- a/app/Services/Learning/Receipt.php	1970-01-01 08:00:00.000000000 +0800
+++ b/app/Services/Learning/Receipt.php	2026-11-05 22:57:02.296982761 +0800
@@ -0,0 +1,178 @@
+<?php
+/**
+ * 考试平台投递回执处理
+ *
+ * 本平台把 course.completed 推给考试平台后，只知道「网关收下了」，
+ * 并不知道「考试平台是否真的入库」。回执接口补上这一段：
+ * 考试平台入库成功后回传 exam.progress.ack，本平台把发件箱记录标记为已确认。
+ *
+ * 回执与推送的关系是 1:1，靠 correlationId（被回执进度事件的 eventId）关联。
+ * 回执本身也走幂等：对端可能因为网络抖动重发，按 (source, receiptId) 去重。
+ *
+ * 注意方向：本类处理的是「对端 → 本平台」，属于反向通道，
+ * 不受接入说明 8.1 事件目录约束（该约束只针对本平台向外发的事件）。
+ */
+
+namespace App\Services\Learning;
+
+use App\Models\PeerInbox as PeerInboxModel;
+use App\Repos\ExamOutbox as ExamOutboxRepo;
+use App\Repos\PeerInbox as PeerInboxRepo;
+use App\Services\Service;
+
+class Receipt extends Service
+{
+
+    /**
+     * 回执事件类型（唯一允许的类型，避免对端用回执通道传别的东西）
+     */
+    const EVENT_ACK = 'exam.progress.ack';
+
+    const ACCEPTED = 'accepted';
+
+    const REJECTED = 'rejected';
+
+    /**
+     * 应用一条回执
+     *
+     * @param string $source 对端标识
+     * @param array $body 事件封套
+     * @param string $requestId 网关请求编号
+     * @return array{ok:bool,code:string,message:string,status:string,data:array}
+     */
+    public function apply($source, array $body, $requestId = '')
+    {
+        $registry = new Peers();
+
+        if (!$registry->hasAbility($source, 'ack')) {
+            return $this->reject('RECEIPT_NOT_OPEN', sprintf('对端 %s 未开通回执通道', $source));
+        }
+
+        $receiptId = trim((string)($body['eventId'] ?? ''));
+
+        $eventType = trim((string)($body['eventType'] ?? self::EVENT_ACK));
+
+        if ($receiptId === '' || $eventType === '') {
+            return $this->reject('VALIDATION_ERROR', '缺少 eventId 或 eventType');
+        }
+
+        if (strlen($receiptId) > 64) {
+            return $this->reject('VALIDATION_ERROR', 'eventId 超长');
+        }
+
+        if ($eventType !== self::EVENT_ACK) {
+            return $this->reject('EVENT_NOT_ALLOWED', sprintf('回执通道只接受 %s', self::EVENT_ACK));
+        }
+
+        $payload = isset($body['payload']) && is_array($body['payload']) ? $body['payload'] : [];
+
+        $targetEventId = trim((string)($body['correlationId'] ?? ($payload['eventId'] ?? '')));
+
+        if ($targetEventId === '') {
+            return $this->reject('VALIDATION_ERROR', '缺少 correlationId（被回执的进度事件 eventId）');
+        }
+
+        $ackStatus = strtolower(trim((string)($payload['status'] ?? self::ACCEPTED)));
+
+        if (!in_array($ackStatus, [self::ACCEPTED, self::REJECTED], true)) {
+            return $this->reject('VALIDATION_ERROR', 'payload.status 只能是 accepted 或 rejected');
+        }
+
+        $remoteId = trim((string)($payload['remoteId'] ?? ''));
+
+        $reason = trim((string)($payload['reason'] ?? ''));
+
+        $inboxRepo = new PeerInboxRepo();
+
+        $exists = $inboxRepo->findByEventId($source, $receiptId);
+
+        if ($exists) {
+            return [
+                'ok' => true,
+                'code' => 'OK',
+                'message' => '该回执已受理，幂等返回',
+                'status' => 'duplicate',
+                'data' => [
+                    'receiptId' => $receiptId,
+                    'targetEventId' => $targetEventId,
+                    'ackStatus' => (string)$exists->note,
+                ],
+            ];
+        }
+
+        $repo = new ExamOutboxRepo();
+
+        $event = $repo->findByEventId($targetEventId);
+
+        if (!$event || (string)$event->target !== (string)$source) {
+            return $this->reject('TARGET_EVENT_NOT_FOUND', '被回执的进度事件不存在或不属于该对端');
+        }
+
+        $repo->acknowledge($event, $ackStatus, $remoteId, $reason);
+
+        $inbox = new PeerInboxModel();
+
+        $inbox->source = (string)$source;
+        $inbox->event_id = $receiptId;
+        $inbox->event_type = $eventType;
+        $inbox->event_version = (string)($body['eventVersion'] ?? '1.0');
+        $inbox->actor_key = (string)($body['actorId'] ?? '');
+        $inbox->payload = kg_json_encode($body);
+        $inbox->status = $ackStatus === self::ACCEPTED
+            ? PeerInboxModel::STATUS_PROCESSED : PeerInboxModel::STATUS_IGNORED;
+        $inbox->note = $ackStatus;
+        $inbox->request_id = (string)$requestId;
+        $inbox->received_at = time();
+        $inbox->processed_at = time();
+
+        $inbox->create();
+
+        return [
+            'ok' => true,
+            'code' => 'OK',
+            'message' => $ackStatus === self::ACCEPTED ? '回执已确认' : '回执已记录，事件转为待重试',
+            'status' => 'accepted',
+            'data' => [
+                'receiptId' => $receiptId,
+                'targetEventId' => $targetEventId,
+                'ackStatus' => $ackStatus,
+                'remoteId' => (string)$event->remote_id,
+                'ackedAt' => gmdate('Y-m-d\TH:i:s\Z', (int)$event->acked_at),
+                'eventStatus' => (int)$event->status,
+            ],
+        ];
+    }
+
+    /**
+     * 已确认分布（页面与对账用）
+     *
+     * @param string $source
+     * @return array
+     */
+    public function summary($source)
+    {
+        $repo = new ExamOutboxRepo();
+
+        return [
+            'acked' => $repo->countAcked($source, true),
+            'unacked' => $repo->countAcked($source, false),
+        ];
+    }
+
+    /**
+     * @param string $code
+     * @param string $message
+     * @return array
+     */
+    protected function reject($code, $message)
+    {
+        return [
+            'ok' => false,
+            'code' => $code,
+            'message' => $message,
+            'status' => 'rejected',
+            'data' => [],
+        ];
+    }
+
+}
diff -urN --strip-trailing-cr app/Services/Learning/Replay.php /www/ctc/app/Services/Learning/Replay.php
--- a/app/Services/Learning/Replay.php	1970-01-01 08:00:00.000000000 +0800
+++ b/app/Services/Learning/Replay.php	2026-11-05 22:59:30.127102327 +0800
@@ -0,0 +1,166 @@
+<?php
+/**
+ * 失败事件重放（对账后重推）
+ *
+ * 死信不会自动重试，这是有意为之：连续失败通常意味着契约变更或对端故障，
+ * 盲目重试只会放大故障。但对账修好之后需要一个明确的重推入口，本类就是它。
+ *
+ * 只做「重置为待投递」，不在 HTTP 请求里直接投递：
+ * 1) 投递要走网关，耗时不可控，不能占着请求线程；
+ * 2) 重置后由 exam_sync 定时任务（3 分钟一轮）按退避策略自然接走，
+ *    也能被下一次一键同步立即带走，两条路径都通。
+ */
+
+namespace App\Services\Learning;
+
+use App\Models\ExamOutbox as ExamOutboxModel;
+use App\Repos\ExamOutbox as ExamOutboxRepo;
+use App\Services\Service;
+
+class Replay extends Service
+{
+
+    /**
+     * 单次重放上限，防止对端一次把整表翻起来
+     */
+    const MAX_BATCH = 100;
+
+    /**
+     * 重置事件为待投递
+     *
+     * @param string $source 对端标识
+     * @param array $body {eventIds?: array, userId?: string, courseId?: int}
+     * @return array
+     */
+    public function apply($source, array $body)
+    {
+        $registry = new Peers();
+
+        if (!$registry->hasAbility($source, 'replay')) {
+            return $this->reject('REPLAY_NOT_OPEN', sprintf('对端 %s 未开通重放通道', $source));
+        }
+
+        $eventIds = isset($body['eventIds']) && is_array($body['eventIds']) ? $body['eventIds'] : [];
+
+        $userKey = trim((string)($body['userId'] ?? ''));
+
+        $courseId = isset($body['courseId']) ? (int)$body['courseId'] : 0;
+
+        if (count($eventIds) == 0 && $userKey === '') {
+            return $this->reject('VALIDATION_ERROR', '需提供 eventIds，或提供 userId（可带 courseId）按条件重放');
+        }
+
+        if (count($eventIds) > self::MAX_BATCH) {
+            return $this->reject('VALIDATION_ERROR', sprintf('单次最多重放 %d 条', self::MAX_BATCH));
+        }
+
+        $repo = new ExamOutboxRepo();
+
+        $replayed = [];
+
+        $skipped = [];
+
+        if (count($eventIds) > 0) {
+
+            $map = $repo->findByEventIds($eventIds, $source);
+
+            foreach ($eventIds as $eventId) {
+
+                $eventId = trim((string)$eventId);
+
+                if ($eventId === '') continue;
+
+                if (!isset($map[$eventId])) {
+                    $skipped[] = ['eventId' => $eventId, 'reason' => 'NOT_FOUND'];
+                    continue;
+                }
+
+                $row = $map[$eventId];
+
+                $reason = $this->skipReason($row, $registry, $source);
+
+                if ($reason !== '') {
+                    $skipped[] = ['eventId' => $eventId, 'reason' => $reason];
+                    continue;
+                }
+
+                $repo->resetForReplay($row);
+
+                $replayed[] = $eventId;
+            }
+        } else {
+
+            $identity = new IdentityKey();
+
+            $userId = (int)$identity->resolveUserId($userKey);
+
+            if ($userId <= 0) {
+                return $this->reject('USER_NOT_FOUND', '该用户不存在');
+            }
+
+            $rows = $repo->findReplayable($userId, $courseId, $source, self::MAX_BATCH, $registry->get($source)['events']);
+
+            foreach ($rows as $row) {
+                $repo->resetForReplay($row);
+                $replayed[] = (string)$row->event_id;
+            }
+        }
+
+        return [
+            'ok' => true,
+            'code' => 'OK',
+            'message' => count($replayed) > 0 ? '已重置为待投递' : '没有需要重放的事件',
+            'data' => [
+                'peer' => $source,
+                'requested' => count($eventIds),
+                'replayed' => count($replayed),
+                'eventIds' => $replayed,
+                'skipped' => $skipped,
+                'deliveredBy' => 'exam_sync（3 分钟一轮）或下一次一键同步',
+            ],
+        ];
+    }
+
+    /**
+     * 该事件是否可重放；返回空串表示可以
+     *
+     * @param ExamOutboxModel $row
+     * @param Peers $registry
+     * @param string $source
+     * @return string
+     */
+    protected function skipReason(ExamOutboxModel $row, Peers $registry, $source)
+    {
+        if ($registry->allows($source, (string)$row->event_type) === '') {
+            return 'EVENT_NOT_ALLOWED';
+        }
+
+        $status = (int)$row->status;
+
+        if ($status === ExamOutboxModel::STATUS_PENDING) {
+            return 'ALREADY_PENDING';
+        }
+
+        if ($status === ExamOutboxModel::STATUS_SENT) {
+            return $row->isAcked() ? 'ALREADY_ACKED' : 'ALREADY_SENT';
+        }
+
+        return '';
+    }
+
+    /**
+     * @param string $code
+     * @param string $message
+     * @return array
+     */
+    protected function reject($code, $message)
+    {
+        return [
+            'ok' => false,
+            'code' => $code,
+            'message' => $message,
+            'data' => [],
+        ];
+    }
+
+}
