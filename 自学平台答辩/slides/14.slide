            paddingLeft: 6,
            paddingRight: 6,
        }}
        cells={[
            [
                { text: '场景', textStyle: { bold: true, color: '#1E4FA8', fontSize: 14 }, cellStyle: { border: { bottom: { width: 2, color: '#1E4FA8' } } } },
                { text: '指标', textStyle: { bold: true, color: '#1E4FA8', fontSize: 14 }, cellStyle: { border: { bottom: { width: 2, color: '#1E4FA8' } } } },
                { text: '口径与前提', textStyle: { bold: true, color: '#1E4FA8', fontSize: 14 }, cellStyle: { border: { bottom: { width: 2, color: '#1E4FA8' } } } },
            ],
            ['课程列表首屏', { text: '≤ 1.5s', textStyle: { bold: true } }, 'LCP · P75 · 含封面图'],
            ['课程详情可交互', { text: '≤ 1.8s', textStyle: { bold: true } }, 'TTI · P75 · 目录 ≤200 课时'],
            ['视频起播时间', { text: '≤ 2s', textStyle: { bold: true } }, 'P75 · 1080p · CDN 命中'],
            ['学习进度上报', { text: '≤ 200ms', textStyle: { bold: true, color: '#1E4FA8' } }, 'P95 · 单条写入'],
            ['课程列表 / 搜索', { text: '≤ 300ms', textStyle: { bold: true } }, 'P95 · pageSize ≤20'],
            ['完成状态单查', { text: '≤ 300ms', textStyle: { bold: true } }, 'P95 · 外部系统调用'],
            ['完成状态批量', { text: '≤ 800ms', textStyle: { bold: true } }, 'P95 · 1000 组上限'],
            ['并发在线学习', { text: '500 人 / 210 QPS', textStyle: { bold: true } }, '按开学第一周峰值估算'],
        ]}
    />

    <Box style={{ position: 'absolute', left: 800, top: 118, width: 420, height: 2, background: '#D6DCE5' }} />
    <Text style={{ position: 'absolute', left: 800, top: 130, fontSize: 18, fontWeight: 'bold', color: '#4A5568' }}>
        可用性与恢复
    </Text>

    <Box style={{ position: 'absolute', left: 800, top: 166, width: 420, flexDirection: 'column', gap: 16 }}>
        <Box style={{ flexDirection: 'column', gap: 2 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
                <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>99.9</Text>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', marginLeft: 4, marginBottom: 4 }}>%</Text>
            </Box>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>对外完成状态查询可用率（服务整体 99.5%）</Text>
        </Box>
        <Box style={{ height: 1, background: '#E5E7EB' }} />
        <Box style={{ flexDirection: 'column', gap: 2 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
                <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>15</Text>
