        <Box style={{ height: 1, background: '#E5E7EB' }} />
        <Box style={{ flexDirection: 'column', gap: 2 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
                <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>5</Text>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', marginLeft: 4, marginBottom: 4 }}>s</Text>
            </Box>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>完成到下游可查的 P95 事件时延</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 60, top: 580, width: 1160, height: 56, background: '#F7F9FC', borderLeft: '3px solid #1E4FA8', flexDirection: 'row', alignItems: 'center', paddingLeft: 20 }}>
        <Text style={{ fontSize: 18, color: '#1A2230' }}>
